{
  "notes": "Example shift_req.json showcasing all supported fields. Use 'notes' strings for guidance (keeps JSON valid). Day keys are: sun, mon, tue, wed, thu, fri, sat.",
  "week_date": null,
  "cases": [
    {
      "case_id": "Baseline-Only",
      "notes": "Basic case using current week (week_date = null). Uses k=3 and only 'days'; no backup.",
      "k": 3,
      "slot_min": 30,
      "days": {
        "mon": ["09:00-11:00"],
        "tue": ["13:00-15:00"],
        "fri": ["10:30-12:00"]
      },
      "specific": [],
      "backup_strategy": null
    },
    {
      "case_id": "Week-Override-And-Specific",
      "notes": "Override week by case-level week_date and add a specific date. Also show relax backup_strategy.",
      "week_date": "2025-10-15",
      "k": 2,
      "slot_min": 45,
      "days": {
        "mon": ["09:00-12:00"],
        "thu": ["14:00-16:00"]
      },
      "specific": [
        { "date": "2025-10-17", "ranges": ["16:00-18:00"] }
      ],
      "backup_strategy": { "type": "relax_minutes", "minutes": 15 }
    },
    {
      "case_id": "Auto-K-Bump-Demo",
      "notes": "If any day has more than two ranges, internal allowed k auto-bumps to 4.",
      "k": 3,
      "slot_min": 30,
      "days": {
        "wed": ["08:00-09:00", "11:00-12:00", "15:00-16:00"]
      },
      "specific": [],
      "backup_strategy": { "type": "relax_minutes", "minutes": 30 }
    },
    {
      "case_id": "Full-Options",
      "notes": "Show all optional fields filled, and all weekday keys. enumerate_all lists all covering combinations; include_supersets controls whether to also list non-minimal supersets.",
      "week_date": "2025-10-13",
      "k": 3,
      "slot_min": 30,
      "days": {
        "sun": ["08:30-09:30"],
        "mon": ["16:00-18:00"],
        "tue": ["09:30-10:00", "14:00-17:30"],
        "wed": ["15:00-17:00"],
        "thu": ["09:00-10:00"],
        "fri": ["10:00-12:00"],
        "sat": ["13:00-14:30"]
      },
      "specific": [
        { "date": "2025-10-16", "ranges": ["18:00-20:00"] }
      ],
      "backup_strategy": { "type": "relax_minutes", "minutes": 30 },
      "enumerate_all": true,
      "max_team_size": 3,
      "include_supersets": false
    }
  ]
}
